# snmptrap.conf - optional SNMP trap destination for the promise-mdmonitor
# handler. Install as /etc/promise/snmptrap.conf and set these to your NMS /
# trap receiver. Without this file, traps go to promise_trap's built-in default
# (127.0.0.1, community "VessApp"). The trap is a Promise raidv4TrapMessage
# (.1.3.6.1.4.1.7933.1.20.0.11.0.1) - load raidv4.mib on the receiver to decode
# the 7 varbinds (SequenceNo, Id, DefaultId, Severity, Source, TimeStamp, Desc).
SNMP_TRAP_HOST=nms.example.com
SNMP_TRAP_COMMUNITY=VessApp
