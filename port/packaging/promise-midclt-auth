#!/usr/bin/env python3
"""promise-midclt-auth - WebPAM auth backend for the TrueNAS app (container).

Drop-in for promise-pam-auth. php_i2 execs the auth helper as:
    promise-pam-auth <username>        # password on stdin, one line
and reads the exit status: 0 = authenticated, 1 = denied, 2 = usage error.

Rather than local PAM, this validates against the HOST's TrueNAS accounts through
the middleware, reached exactly as the health probe reaches zpool: nsenter into
PID 1 and run the host's `midclt`. Only users already on the WebPAM allowlist
(/etc/promise/webpam.pamusers, maintained by promise-webpam-group-sync) ever
reach this helper, so service/system accounts are never offered here.

VERIFY ON THE BOX: the exact `auth.check_password` call form for your TrueNAS
version (older builds expose `auth.check_password <user> <pass>` returning a
JSON boolean; 25.10 may prefer the `auth.login_ex` flow).
"""
import json
import os
import subprocess
import sys


def host_cmd(args):
    """Prefix with nsenter-into-PID-1 when running inside the container."""
    if os.environ.get("VESSAPP_PROBE_NSENTER"):
        return ["nsenter", "-t", "1", "-m", "-u", "-i", "-n", "-p", "--"] + args
    return args


def main():
    if len(sys.argv) < 2 or not sys.argv[1]:
        return 2
    user = sys.argv[1]
    password = sys.stdin.readline().rstrip("\n")
    if not password:                      # no NULL authentication
        return 1
    # user + password are passed as JSON values so spaces/quotes are handled by
    # midclt, never re-parsed by a shell.
    cmd = host_cmd(["midclt", "call", "auth.check_password",
                    json.dumps(user), json.dumps(password)])
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
    except Exception:
        return 1
    return 0 if res.returncode == 0 and res.stdout.strip().lower() == "true" else 1


if __name__ == "__main__":
    sys.exit(main())
