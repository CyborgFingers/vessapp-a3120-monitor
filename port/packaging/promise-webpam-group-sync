#!/usr/bin/env python3
"""promise-webpam-group-sync - mirror a TrueNAS group into the WebPAM allowlist.

Ensures a `webpam` group exists on the TrueNAS host, then writes every member of
that group (and of the builtin administrators group) into the WebPAM PAM
allowlist (/etc/promise/webpam.pamusers, "username:groupId"). php_i2 then lets
those users sign in to WebPAM with their TrueNAS password (via the midclt
promise-pam-auth backend) at the privilege below. So: add someone to the
`webpam` group in TrueNAS - or make them a TrueNAS admin - and they can log in.

Host access mirrors the health probe: nsenter into PID 1 + the host's `midclt`.

VERIFY ON THE BOX: the admin group name (`builtin_administrators` here) and the
group.create / group.query / user.query field names on your TrueNAS version.
Offline check of the parsing:  promise-webpam-group-sync --self-test
"""
import json
import os
import subprocess
import sys

GROUP = "webpam"
ADMIN_GROUPS = ("builtin_administrators",)   # TrueNAS admins also get WebPAM access
PRIV = 4                                     # WebPAM groupId 4 = super (full admin)
ALLOWLIST = "/etc/promise/webpam.pamusers"
UID_MIN = 1000                               # never allowlist system/service accounts


def host(args):
    pre = (["nsenter", "-t", "1", "-m", "-u", "-i", "-n", "-p", "--"]
           if os.environ.get("VESSAPP_PROBE_NSENTER") else [])
    return subprocess.run(pre + args, capture_output=True, text=True, timeout=30)


def midclt(method, *params):
    r = host(["midclt", "call", method, *[json.dumps(p) for p in params]])
    if r.returncode != 0:
        raise RuntimeError(f"{method}: {r.stderr.strip() or r.returncode}")
    return json.loads(r.stdout or "null")


# --- pure helpers (offline-testable) ---------------------------------------
def member_ids(groups, wanted_names):
    """Set of user ids drawn from the groups whose name is in wanted_names."""
    ids = set()
    for g in groups or []:
        if g.get("name") in wanted_names:
            ids.update(g.get("users") or [])
    return ids


def allowlist_lines(users, ids, priv=PRIV, uid_min=UID_MIN):
    """`username:priv` lines for real (non-builtin, uid>=uid_min) users in ids."""
    out = set()
    for u in users or []:
        if u.get("id") in ids and not u.get("builtin") and (u.get("uid") or 0) >= uid_min:
            name = u.get("username")
            if name:
                out.add(f"{name}:{priv}")
    return sorted(out)


# --- live sync --------------------------------------------------------------
def sync():
    groups = midclt("group.query")
    if not any(g.get("name") == GROUP for g in groups):
        midclt("group.create", {"name": GROUP})
        groups = midclt("group.query")
    ids = member_ids(groups, {GROUP, *ADMIN_GROUPS})
    users = midclt("user.query")
    lines = allowlist_lines(users, ids)
    tmp = ALLOWLIST + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lines) + ("\n" if lines else ""))
    os.replace(tmp, ALLOWLIST)
    return len(lines)


def self_test():
    groups = [{"name": "webpam", "users": [101, 102]},
              {"name": "builtin_administrators", "users": [1, 101, 200]},
              {"name": "other", "users": [300]}]
    users = [{"id": 101, "username": "alice", "uid": 3001, "builtin": False},
             {"id": 102, "username": "bob",   "uid": 3002, "builtin": False},
             {"id": 1,   "username": "root",  "uid": 0,    "builtin": True},
             {"id": 200, "username": "svc",   "uid": 57,   "builtin": True},
             {"id": 300, "username": "carol", "uid": 3003, "builtin": False}]
    ids = member_ids(groups, {"webpam", "builtin_administrators"})
    assert ids == {101, 102, 1, 200}, ids
    lines = allowlist_lines(users, ids)
    # root/svc excluded (builtin + low uid); carol excluded (not a member)
    assert lines == ["alice:4", "bob:4"], lines
    print("self-test OK")


if __name__ == "__main__":
    if "--self-test" in sys.argv[1:]:
        self_test()
        sys.exit(0)
    try:
        n = sync()
        print(f"[group-sync] {n} user(s) in the WebPAM allowlist")
    except Exception as e:
        print(f"[group-sync] FAILED: {e}", file=sys.stderr)
        sys.exit(1)
